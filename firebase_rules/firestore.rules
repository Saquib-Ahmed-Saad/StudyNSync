rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return signedIn()
        && groupDoc(groupId).data.memberIds is list
        && request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn() && groupDoc(groupId).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@]+@(.+\\.)?gsu\\.edu$');

      allow read, update, delete: if isSelf(userId);

      match /tasks/{taskId} {
        allow read, write: if isSelf(userId);
      }

      match /weeklyPlans/{planId} {
        allow read, write: if isSelf(userId);

        match /items/{itemId} {
          allow read, write: if isSelf(userId);
        }
      }

      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isSelf(userId);
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.capacity is int
        && request.resource.data.occupiedSeats is int
        && request.resource.data.occupiedSeats >= 0
        && request.resource.data.occupiedSeats <= request.resource.data.capacity;

      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow update: if signedIn()
        && (
          isGroupMember(groupId)
          || request.auth.uid in request.resource.data.memberIds
        );

      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && (request.auth.uid == memberId || isGroupOwner(groupId));

        allow update, delete: if signedIn()
          && (request.auth.uid == memberId || isGroupOwner(groupId));
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update, delete: if false;
      }

      match /timer/{timerDocId} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    match /sessions/{sessionId} {
      allow read: if signedIn()
        && (
          request.auth.uid in resource.data.participantIds
          || isGroupMember(resource.data.groupId)
        );

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds;

      allow update, delete: if signedIn()
        && (
          request.auth.uid == resource.data.createdBy
          || isGroupMember(resource.data.groupId)
        );
    }

    match /notificationQueue/{notificationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;

      allow update, delete: if false;
    }
  }
}